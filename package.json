{
  "name": "mayf3-hybrid-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "typescript-eslint": "^8.46.0"
  },
  "scripts": {
    "dev": "pnpm tokens:build && pnpm --filter @mayf3/workbench dev",
    "tokens:build": "node tools/generate-theme-css.mjs",
    "build": "pnpm tokens:build && pnpm --filter @mayf3/ui-react build",
    "build:workbench": "pnpm tokens:build && pnpm --filter @mayf3/workbench build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages workbench tools",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:unit": "pnpm --filter @mayf3/ui-react test",
    "test:browser": "pnpm tokens:build && pnpm --filter @mayf3/workbench test",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:exports": "node tools/check-exports.mjs",
    "verify": "pnpm build && pnpm check:exports && pnpm check:tokens && pnpm typecheck && pnpm lint && pnpm test:unit"
  }
}
